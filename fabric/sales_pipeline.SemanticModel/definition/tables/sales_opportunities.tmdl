table sales_opportunities
	lineageTag: 21dc399f-bfe6-49c7-a8ed-f6ef3897bc16
	sourceLineageTag: [dbo].[sales_opportunities]

	measure yearly_revenue =
			SUMX (
			    'sales_opportunities',
			    VAR EndDate = 'sales_opportunities'[end_date]
			    VAR MonthsBetween =
			        DATEDIFF (
			            EndDate,
			            DATE ( YEAR ( EndDate ), 12, 31 ),
			            MONTH
			        )
			    RETURN
			        'sales_opportunities'[monthly_recurring_revenue] * MonthsBetween
			)
		lineageTag: 70209bb5-8d72-47c3-a562-6bd84aaa8825

		changedProperty = Name


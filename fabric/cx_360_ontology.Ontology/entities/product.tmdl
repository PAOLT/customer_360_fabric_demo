/// A product or business module in the CX 360 dataset.
entity product
	lineageTag: 87376ea3-2e60-4621-a31a-2d9b11f0929f
	backingTable: product
	keyProperty: product_id

	/// Unique product identifier.
	property product_id
		dataType: string
		lineageTag: 26b0fbd3-1af6-4398-8805-37003849e127


relationship sales_opportunity_product_join
	fromColumn: sales_opportunity.product_id
	toColumn: product.product_id

relationship sales_opportunity_employee_join
	fromColumn: sales_opportunity.account_executive_id
	toColumn: employee.employee_id

relationship subscription_payment_subscription_join
	fromColumn: subscription_payment.subscription_id
